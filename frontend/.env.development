# Loaded automatically by Create React App during `npm start` ONLY.
# Production builds (`npm run build`) do NOT read this file — they use
# .env.production / CI env vars, and fall back to https://api.jaspen.ai
# (see src/config/apiBase.js).
#
# This file is committed on purpose: it contains no secrets and guarantees
# local dev talks to the LOCAL backend, never production.

REACT_APP_API_BASE=http://localhost:8000

# To point local dev at production temporarily (read-only smoke checks only),
# create frontend/.env.development.local (gitignored) with:
#   REACT_APP_API_BASE=https://api.jaspen.ai
