# Jaspen frontend environment — EXAMPLE
#
# Local development normally needs NO .env here: .env.development (committed)
# already points `npm start` at the local backend (http://localhost:8000).
#
# This file documents the optional variables. Copy to .env only if you need
# the SFTP deploy scripts (npm run deploy) — that .env is gitignored.

# --- API target overrides (rarely needed) ---
# REACT_APP_API_BASE=http://localhost:8000

# --- SFTP deploy (npm run deploy / npm run deploy:check) ---
# Legacy path; primary deploys go through GitHub Actions → Vercel.
# SFTP_HOST=
# SFTP_PORT=22
# SFTP_USER=
# SFTP_PASS=            # or use SSH_KEY_PATH
# SSH_KEY_PATH=
# SSH_KEY_PASSPHRASE=
# REMOTE_PATH=/public_html/jaspen
# LOCAL_BUILD_DIR=build
# DEPLOY_CLEAN=false
