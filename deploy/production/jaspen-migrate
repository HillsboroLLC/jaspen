#!/usr/bin/env bash
# Install root-owned as /usr/local/sbin/jaspen-migrate (mode 0755).
set -euo pipefail

readonly CONFIG_FILE="/etc/jaspen/deploy.conf"
[[ -f "${CONFIG_FILE}" ]] || exit 1
[[ "$(stat -c '%u' "${CONFIG_FILE}")" == "0" ]] || exit 1
[[ "$(stat -c '%a' "${CONFIG_FILE}")" =~ ^(600|640|644)$ ]] || exit 1
source "${CONFIG_FILE}"
[[ "${DEPLOY_ROOT:-}" == /* ]] || exit 1

cd "${DEPLOY_ROOT}/backend"
exec "${DEPLOY_ROOT}/backend/venv/bin/python" migrate_production.py
