# Copy to ~/.config/jaspen/staging-operator.conf on the operator's machine
# (mode 600). Placeholders only; never commit the real file.

# SSH alias or host name of the staging server, and the login used for uploads.
# An alias defined in ~/.ssh/config is preferred.
SSH_HOST=staging-ssh-alias
SSH_USER=staging-operator-user

# Optional: key and pinned known_hosts file for this server.
SSH_IDENTITY_FILE=
SSH_KNOWN_HOSTS_FILE=

# Optional: path to an SSH helper executable used instead of plain ssh/scp.
SSH_HELPER=

# Upload directory on the server (absolute). The deploy wrapper copies the
# artifacts from here into its own root-controlled directory and verifies them.
REMOTE_UPLOAD_DIR=/absolute/path/for/staging/uploads
