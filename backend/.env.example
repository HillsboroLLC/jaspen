# =============================================================================
# Jaspen backend environment — EXAMPLE
# =============================================================================
# Copy to backend/.env and fill in values:   cp .env.example .env
# `scripts/dev_setup.sh` (repo root) does this for you with generated secrets.
#
# backend/.env is gitignored. NEVER commit real secrets.
# Production values live in the DigitalOcean server's .env (~/sekki-platform),
# NOT in this repo. Do not copy production values here.
# =============================================================================

# ---------------------------------------------------------------------------
# Core (REQUIRED — the app refuses to boot without these)
# ---------------------------------------------------------------------------
# development | production. Production enables strict guards (live Stripe key
# required, CONNECTOR_ENCRYPTION_KEY required, etc.)
FLASK_ENV=development
APP_ENV=development

# Flask session/signing secret. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# JWT signing secret (auth cookies). Generate the same way. REQUIRED.
JWT_SECRET_KEY=replace-me

# Database. Dev default is a local SQLite file (created under backend/instance/).
# Production uses PostgreSQL, e.g. postgresql+psycopg://user:pass@host:5432/jaspen
DATABASE_URL=sqlite:///jaspen_dev.db

# Stripe secret key. REQUIRED at boot (app raises without it).
# Dev: a placeholder test-format key boots fine; billing endpoints will fail
# only when actually exercised. Use a real sk_test_... key to test billing.
# NEVER put a live key (sk_live_...) in a dev .env.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (required in production only; optional in dev)
PRICE_ID_ESSENTIAL=
PRICE_ID_TEAM=
PRICE_ID_ENTERPRISE=
PRICE_ID_CREDITS_3000=
PRICE_ID_CREDITS_8000=
PRICE_ID_CREDITS_18000=
# One-time $999 price for The Jaspen Advantage. Do not use a recurring price.
PRICE_ID_JASPEN_ADVANTAGE=

# ---------------------------------------------------------------------------
# Frontend origin / CORS / cookies (dev-critical)
# ---------------------------------------------------------------------------
# Where the React app runs. Used for redirect links and CORS defaults.
FRONTEND_BASE_URL=http://localhost:3000

# Explicit CORS allowlist (comma-separated). Covers both common dev ports.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Flask-level CORS. true for local dev (no Nginx in front). In production Nginx
# terminates CORS and this must be false/unset.
ENABLE_FLASK_CORS=true

# Cookies: MUST be false in dev (no HTTPS on localhost) or login silently fails.
# Production: true.
JWT_COOKIE_SECURE=false
JWT_COOKIE_CSRF_PROTECT=true
JWT_COOKIE_SAMESITE=Lax
# JWT_COOKIE_DOMAIN=            # leave unset for localhost
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2

# ---------------------------------------------------------------------------
# Signup / email verification
# ---------------------------------------------------------------------------
# false in dev so signup works without a mail server. true in production.
REQUIRE_EMAIL_VERIFICATION=false

# Mail (optional in dev — only needed to test verification/reset emails)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Authenticated decision-result emails reuse the same SMTP provider.
DECISION_ASSET_EMAIL_SENDER_NAME=Jaspen
DECISION_ASSET_EMAIL_REPLY_TO=
DECISION_ASSET_EMAIL_MAX_ATTACHMENT_BYTES=15728640
DECISION_ASSET_EMAIL_RATE_LIMIT_PER_HOUR=5
SALES_NOTIFICATION_EMAIL=sales@jaspen.ai
PRICE_ID_BUSINESS=
PRICE_ID_BUSINESS_ANNUAL=
PRICE_ID_BUSINESS_ADDITIONAL_SEAT=
LEAD_TOOLKIT_LINK_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# AI providers (optional in dev; required to exercise scoring/chat/agent)
# ---------------------------------------------------------------------------
# Anthropic — used for judgment work (scoring, scenarios, agent replies)
ANTHROPIC_API_KEY=
# Gemini — used for processing work (data, monitoring)
GEMINI_API_KEY=

# Model pinning (defaults are sensible; override to match production pins)
# MODEL_CLAUDE_HAIKU=claude-haiku-4-5
# MODEL_CLAUDE_SONNET=claude-sonnet-4-6
# MODEL_CLAUDE_OPUS=claude-opus-4-8
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# GEMINI_MODEL_PRO=gemini-2.5-pro

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Comma-separated emails that get admin routes. The dev seed script creates
# dev-admin@jaspen.local, so keep it listed here for local admin testing.
ADMIN_EMAILS=dev-admin@jaspen.local
ADMIN_USER_IDS=
ADMIN_BLOCKED_EMAILS=

# ---------------------------------------------------------------------------
# Connectors (all optional in dev; connector pages load without them)
# ---------------------------------------------------------------------------
# Fernet key encrypting stored connector credentials. Required in production.
# Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CONNECTOR_ENCRYPTION_KEY=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=
JIRA_WEBHOOK_SECRET=

WORKFRONT_BASE_URL=
WORKFRONT_PROJECT_ID=
WORKFRONT_API_TOKEN=
WORKFRONT_WEBHOOK_SECRET=

SMARTSHEET_SHEET_ID=
SMARTSHEET_API_TOKEN=
SMARTSHEET_WEBHOOK_SECRET=

SALESFORCE_AUTH_BASE_URL=https://login.salesforce.com
SALESFORCE_REDIRECT_URI=

SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---------------------------------------------------------------------------
# Google OAuth login (optional in dev; password login works without it)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Observability / misc (all optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
FEEDBACK_DIGEST_RECIPIENTS=
# Local development may use memory://. Production must use a shared Redis URL
# (for example rediss://user:password@host:port/0); the app refuses
# to start with process-local storage in production.
RATELIMIT_STORAGE_URI=memory://
